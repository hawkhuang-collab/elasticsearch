// NESTED reductions over nested_orders: order 1 has items a (qty 1) and b (qty 2) and one event, order 2 has neither,
// order 3 has item c (qty 5) and two events.

reduceEachParent
required_capability: fn_nested

FROM nested_orders
| EVAL s = NESTED(SUM(items.qty)), c = NESTED(COUNT(items.qty)), n = NESTED(items, COUNT(*)), mn = NESTED(MIN(items.qty)), mx = NESTED(MAX(items.qty)), a = NESTED(AVG(items.qty))
| KEEP id, s, c, n, mn, mx, a
| SORT id
;

id:keyword | s:long | c:long | n:long | mn:long | mx:long | a:double
1          | 3      | 2      | 2      | 1       | 2       | 1.5
2          | null   | 0      | 0      | null    | null    | null
3          | 5      | 1      | 1      | 5       | 5       | 5.0
;

reduceKeywordChildren
required_capability: fn_nested

FROM nested_orders
| EVAL lowest = NESTED(MIN(items.sku)), highest = NESTED(MAX(items.sku))
| KEEP id, lowest, highest
| SORT id
;

id:keyword | lowest:keyword | highest:keyword
1          | a             | b
2          | null          | null
3          | c             | c
;

reduceAnExpressionOverChildren
required_capability: fn_nested

FROM nested_orders
| EVAL t = NESTED(SUM(items.qty * 10 + length(items.sku)))
| KEEP id, t
| SORT id
;

id:keyword | t:long
1          | 32
2          | null
3          | 51
;

reduceTwoCollections
required_capability: fn_nested

FROM nested_orders
| EVAL itemCount = NESTED(items, COUNT(*)), eventCount = NESTED(events, COUNT(*))
| KEEP id, itemCount, eventCount
| SORT id
;

id:keyword | itemCount:long | eventCount:long
1          | 2          | 1
2          | 0          | 0
3          | 1          | 2
;

filterOnAReduction
required_capability: fn_nested

FROM nested_orders
| WHERE NESTED(COUNT(items.qty)) > 0
| KEEP id
| SORT id
;

id:keyword
1
3
;

filterOnAReductionOfEmptyParents
required_capability: fn_nested

FROM nested_orders
| WHERE NESTED(items, COUNT(*)) == 0
| KEEP id
;

id:keyword
2
;

reduceAfterKeep
required_capability: fn_nested

FROM nested_orders
| KEEP id
| EVAL s = NESTED(SUM(items.qty))
| SORT id
;

id:keyword | s:long
1          | 3
2          | null
3          | 5
;

reduceAfterAParentFilterAndEval
required_capability: fn_nested

FROM nested_orders
| WHERE id != "2"
| EVAL parent = TO_INTEGER(id) * 100
| EVAL s = NESTED(SUM(items.qty))
| KEEP id, parent, s
| SORT id
;

id:keyword | parent:integer | s:long
1          | 100           | 3
3          | 300           | 5
;

aggregateOverReductions
required_capability: fn_nested

FROM nested_orders
| EVAL n = NESTED(items, COUNT(*))
| STATS total = SUM(n), parents = COUNT(*)
;

total:long | parents:long
3          | 3
;

reduceAfterNestedExpand
required_capability: fn_nested
required_capability: nested_expand

FROM nested_orders
| EVAL n = NESTED(events, COUNT(*))
| NESTED_EXPAND items
| KEEP id, items.sku, n
| SORT id, items.sku
;

id:keyword | items.sku:keyword | n:long
1          | a                 | 1
1          | b                 | 1
2          | null             | 0
3          | c                 | 2
;
